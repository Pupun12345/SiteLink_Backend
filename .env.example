# ------------------------------------------------------------------
# SiteLink Backend — Environment Variables (template)
# Copy to `.env` and fill real values. NEVER commit the real .env.
# ------------------------------------------------------------------

# Server
#
# LIVE SERVER PAR YE `production` HONA HI CHAHIYE.
# `development` rehne par code jaanboojhkar OTP fix rakhta hai ("1234"),
# use API response me bhi bhej deta hai, aur MSG91 ko call hi nahi karta
# — yani koi bhi kisi ke bhi number se login kar lega aur SMS kabhi nahi
# jayega. Deploy karte waqt sabse pehle yahi check kijiye.
NODE_ENV=development            # development | production
PORT=5000

# Database
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority

# JWT
JWT_SECRET=<generate-a-long-random-string-min-32-chars>
JWT_EXPIRE=7d                   # e.g. 15m for access tokens (see audit: shorten this)

# Cloudinary (media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin (Google auth + push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full key. Keep the literal \n escapes; config/firebase.js converts them.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Razorpay (subscription payments)
# KEY_ID is public (also used by the app). KEY_SECRET is server-only — never commit it.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Auto-payment ke webhook ke liye. Razorpay dashboard → Webhooks me
# endpoint add karte waqt jo secret aap set karte hain, wahi yahan aayega
# (KEY_SECRET se alag cheez hai).
#   URL: https://app-sitelink.smartnex.tech/api/payments/webhook
#   Events: subscription.charged, subscription.cancelled,
#           subscription.completed, subscription.halted, subscription.pending
# Iske bina webhook 500 deta hai aur RENEWALS backend tak kabhi nahi
# pahunchte — Razorpay paise kaatta rehta hai par hamare DB me plan
# expire ho jaata hai.
RAZORPAY_WEBHOOK_SECRET=

# Deep links / share (GET /p/:postId)
APP_SCHEME=sitelink
ANDROID_PACKAGE_NAME=com.sitelink.sitelink
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.sitelink.sitelink
APP_STORE_URL=                  # iOS live hone ke baad bharo
# Android App Links verify karne ke liye — release keystore ka SHA-256,
# comma se alag. Tabhi kaam karega jab backend asli https domain par ho.
ANDROID_SHA256_FINGERPRINTS=

# MSG91 (OTP SMS delivery)
#
# India me har SMS ke liye DLT registration zaroori hai. Iske bina MSG91
# request le kar "success" bolta hai, par operator SMS chup-chaap gira
# deta hai. Neeche wali DLT details Airtel DLT portal par registered hain.
#
# AUTH_KEY: MSG91 panel → Settings → Authkey.
#   Ye key IP whitelist ke saath judi hai (Authkey → IP Security = ON).
#   Sirf whitelisted IP (live server) se hi kaam karti hai — isliye IP
#   Security ko kabhi OFF mat chhodiye. Server ka outbound IP badle to
#   naya IP whitelist me daaliye, warna MSG91 error 418 deta hai.
MSG91_AUTH_KEY=                  # MSG91 → Settings → Authkey (asli value sirf server ki .env me)
#
# TEMPLATE_ID: MSG91 ki apni template ID (MSG91 → OTP → Templates me
#   template banane ke baad milti hai, jaise 6516a2f4d6fc0526b2418e52).
#   ⚠️ Ye DLT ki 19-digit Template ID NAHI hai — wo neeche reference me
#   hai aur MSG91 template banate waqt use hoti hai. Galat ID daalne par
#   MSG91 "success" bolta rahega par SMS operator par drop hote rahenge.
MSG91_TEMPLATE_ID=6ac7d3664e6e2e6c3e08d812
#
# ---- DLT reference (code ye values nahi padhta) ----
# Ye sirf record ke liye hain — MSG91 me sender ID aur template banate
# waqt kaam aati hain. Code sirf upar ki do values use karta hai.
#
#   DLT portal         : Airtel (dltconnect.airtel.in)
#   Entity / PE ID     : 1001935674465489507
#   Header / Sender ID : STXTNG  (Other, Permanent)
#   Header DLT ID      : 1005474530608111330
#   Template name      : SiteLink Login OTP
#   Template DLT ID    : 1077284840020606225
#   Template text      : "Your SiteLink Login OTP is {#numeric#}. ..."
#                        MSG91 me {#numeric#} ki jagah ##OTP## likhna hai,
#                        baaki text DLT wale se hubahu milna chahiye.

# ---- Recommended additions (not yet used by code — see audit) ----
# CORS_ORIGINS=https://app.sitelink.com,https://admin.sitelink.com
